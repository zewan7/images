# 数据库配置 - 默认使用SQLite，用户可以自行修改为MySQL
DATABASE_URL=sqlite:///./images.db
# 或者MySQL示例
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/images_db

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8301
DEBUG=False

# 安全密钥配置 - 重要！
# 生产环境必须设置一个强随机密钥，可通过以下命令生成：
# Python: python -c "import secrets; print(secrets.token_hex(32))"
# Linux: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production

# 图片存储配置
IMAGE_UPLOAD_DIR=./images
IMAGE_BASE_URL=http://localhost:8301/images

# 邮件配置（用于邮件验证）
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=your-email@example.com

# 邮件发送后端：smtp=真实发送；console=验证码输出到后端日志（无需邮箱，适合Termux/开发环境）
EMAIL_MODE=console

# Redis配置（用于存储验证码，可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
# 验证码存储后端：redis=使用Redis；memory=纯Python内存存储（不依赖Redis，重启丢失）
OTP_STORAGE_BACKEND=memory

# AI配置
AI_API_URL=https://api.siliconflow.cn/v1/chat/completions
AI_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
AI_API_KEY=your-ai-api-key
THUMBNAIL_SIZE=500,500
THUMBNAIL_QUALITY=95
DEFAULT_USER_ID=4
